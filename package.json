{
  "name": "hyperdope",
  "version": "0.3.1",
  "description": "MCP server for adversarial security research — 6-phase pipeline from profile to disclosure",
  "type": "module",
  "bin": {
    "hyperdope": "bin/hyperdope.js",
    "hd-ci":     "bin/hd-ci.js",
    "hd-run":    "bin/hd-run.js"
  },
  "main": "./src/server.js",
  "exports": {
    ".": {
      "import": "./src/server.js",
      "default": "./src/server.js"
    },
    "./schema": "./src/schema.js",
    "./cvss": "./src/cvss.js",
    "./config": "./src/config.js",
    "./session": "./src/session.js",
    "./providers": "./src/providers/index.js"
  },
  "scripts": {
    "start": "node bin/hyperdope.js",
    "ci":    "node bin/hd-ci.js",
    "run":   "node bin/hd-run.js",
    "test":  "node --test test/*.test.js",
    "lint":  "node --check bin/hyperdope.js bin/hd-ci.js bin/hd-run.js src/server.js src/config.js src/session.js src/cvss.js src/retry.js src/context.js src/extract.js src/schema.js src/ci.js src/tui.js src/providers/index.js src/providers/claude.js src/providers/openai.js src/providers/gemini.js src/providers/ollama.js src/phases/index.js src/phases/profile.js src/phases/audit.js src/phases/confirm.js src/phases/assess.js src/phases/draft_ghsa.js src/phases/disclose.js src/phases/scan.js src/phases/verify.js"
  },
  "keywords": [
    "mcp",
    "security",
    "vulnerability",
    "research",
    "pentest",
    "cvss",
    "ghsa",
    "osv",
    "disclosure",
    "sarif",
    "sbom",
    "ci",
    "claude",
    "llm"
  ],
  "author": "HowToPwn",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HowToPwn/hyperdope.git"
  },
  "homepage": "https://github.com/HowToPwn/hyperdope#readme",
  "bugs": {
    "url": "https://github.com/HowToPwn/hyperdope/issues"
  },
  "files": [
    "bin/",
    "src/config.js",
    "src/session.js",
    "src/server.js",
    "src/cvss.js",
    "src/retry.js",
    "src/context.js",
    "src/extract.js",
    "src/schema.js",
    "src/ci.js",
    "src/tui.js",
    "src/phases/",
    "src/providers/",
    "agent.example.yaml",
    "README.md",
    "LICENSE.md"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.3",
    "@anthropic-ai/sdk":        "^0.54.0",
    "openai":                   "^4.104.0",
    "@google/generative-ai":    "^0.24.1",
    "js-yaml":                  "^4.1.0",
    "zod":                      "^4.4.3"
  },
  "engines": {
    "node": ">=20"
  }
}
